{
  "compilerOptions": {
    "allowJs": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["es2022", "DOM", "WebWorker", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "isolatedModules": true,
    "outDir": "dist/client",
    "noEmit": true,
    "paths": {
      "@backend/*": ["./backend/*"],
      "@ui/*": ["./client/*"],
      "@api/*": ["./api/*"]
    }
  },
  "files": ["./.eslintrc.cjs"],
  "include": ["./*.d.ts", "./*.config.ts", "client"]
}
