{
  "name": "meal-planner",
  "description": "AI-powered meal planning app",
  "engines": {
    "node": "^20.0.0"
  },
  "private": true,
  "trustedDependencies": [
    "sharp"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build.types && npm run build.client && npm run build.ssr.server",
    "build.client": "vite build",
    "build.api": "esbuild api/trpc.ts --bundle --platform=node --outfile=api/trpc.js",
    "build.ssr.server": "vite build -c adapters/vercel-edge/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently --kill-others \"npm run dev.client\" \"npm run dev.backend\"",
    "dev.client": "vite --mode ssr",
    "dev.backend": "tsx watch api/trpc.ts",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"{src,api,backend}/**/*.ts*\"",
    "clean": "rimraf dist",
    "coverage": "vitest run --coverage",
    "test": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.8",
    "@trpc/client": "^11.0.0-next-beta.318",
    "@trpc/server": "^11.0.0-next-beta.318",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "openai": "^5.5.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.7.3",
    "@builder.io/qwik-city": "^1.7.3",
    "@types/eslint": "^8.56.10",
    "@types/express": "^5.0.0",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-qwik": "^1.7.3",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "trpc-ui": "^1.0.12",
    "typescript": "^5.4.2",
    "undici": "*",
    "vercel": "^29.1.1",
    "vite": "^5.2.10",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^3.2.3"
  }
}
